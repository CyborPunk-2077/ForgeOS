# Database
DATABASE_URL=postgresql://forgeos_user:forgeos_password@localhost:5432/forgeos?schema=public

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h

# Refresh Token Configuration
REFRESH_TOKEN_EXPIRES_IN=7d

# Password Hashing
PASSWORD_HASH_ROUNDS=10

# Application
NODE_ENV=development
PORT=3000